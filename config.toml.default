[camera]
source = "/dev/video0"
width = 640
height = 480
fps = 30

[detection]
scrfd_input_size = 320
min_face_size_px = 80
score_threshold = 0.50
nms_threshold = 0.30

[security]
# Face match distance (0 = identical). Smaller is stricter.
golden_threshold = 0.28        # strong match: one clean frame is enough
standard_threshold = 0.42      # normal match: several frames in a row needed
two_factor_threshold = 0.50    # above this the face is a different person
# Anti-spoof "real" score (0..1). Larger is stricter.
spoof_threshold = 0.80           # needed for a one-frame grant
spoof_threshold_standard = 0.70  # needed on every frame of a voted grant
max_retries = 3                  # low anti-spoof frames allowed per scan
global_session_timeout = 7.0     # seconds before falling back to the password (max 7)
gallery_max_size = 20            # learned templates kept per user

[adaptive_policy]
adaptation_limit_per_day = 1

[hardware]
onnx_num_threads = 2             # physical CPU cores
